          "name": "Change Password",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/auth/changePassword",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "changePassword"]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"testuser@example.com\",\n  \"oldPassword\": \"Test@1234\",\n  \"newPassword\": \"NewPass@5678\"\n}"
